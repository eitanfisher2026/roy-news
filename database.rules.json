{
  "rules": {
    "country-meta": {
      ".read": "auth != null && root.child('authorizedUids').child(auth.uid).exists()",
      ".write": false
    },
    "config": {
      "prompts": {
        ".read": "auth != null && root.child('authorizedUids').child(auth.uid).exists()",
        ".write": false
      },
      "contextAnalysisMode": {
        ".read": "auth != null && root.child('authorizedUids').child(auth.uid).exists()",
        ".write": false
      },
      "topics": {
        ".read": "auth != null && root.child('authorizedUids').child(auth.uid).exists()",
        ".write": "auth != null && root.child('authorizedUids').child(auth.uid).exists()"
      }
    },
    "countries": {
      ".read": "auth != null && root.child('authorizedUids').child(auth.uid).exists()",
      "$countryKey": {
        "setup": { ".write": false },
        "runs":  { ".write": false }
      }
    },
    "articleArchiveMeta": {
      ".read": "auth != null && root.child('authorizedUids').child(auth.uid).exists()",
      ".write": false
    },
    "authorizedUsers": {
      ".read": false,
      ".write": false
    },
    "authorizedUids": {
      ".read": false,
      ".write": false
    },
    "userCosts": {
      ".read": false,
      ".write": false
    },
    "usersByEmail": {
      ".read": false,
      ".write": "auth != null && root.child('authorizedUids').child(auth.uid).exists()"
    },
    "users": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
